{
  "extends": "@internal/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*",
    "stories/**/*",
    "test/**/*",
    "scripts/**/*",
    "*.config.ts",
    "*.config.js"
  ]
}
